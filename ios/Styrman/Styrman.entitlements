<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>$(STYRMAN_APS_ENVIRONMENT)</string>
	<!-- The app's own group (same as its app id, so existing items stay); the
	     notification extension shares it to read the pairing. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(STYRMAN_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
