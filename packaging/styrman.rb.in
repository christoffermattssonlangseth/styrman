# Homebrew formula for Styrman (lives in christoffermattssonlangseth/homebrew-styrman).
# Generated by packaging/update-formula.sh: edit the template in the main repo.
class Styrman < Formula
  desc "Steer your coding agents (Claude Code, Codex, agy) from your iPhone"
  homepage "https://github.com/christoffermattssonlangseth/styrman"
  url "https://github.com/christoffermattssonlangseth/styrman/releases/download/v@VERSION@/styrman-@VERSION@-aarch64-apple-darwin.tar.gz"
  sha256 "@SHA256@"
  version "@VERSION@"
  license "MIT"

  depends_on arch: :arm64
  depends_on :macos

  def install
    bin.install "styr", "styrd"
  end

  def caveats
    <<~EOS
      Set Styrman up (background service, agent hooks, pairing your iPhone):
        styr setup
      After upgrading, restart the background service:
        styr service restart
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/styr --version")
  end
end
